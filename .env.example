# BeatAPI/TypeSafe Configuration
# Get your free API key at https://beatapi.io
BEATAPI_API_KEY=your_beatapi_key_here

# Endpoint is pre-configured: https://api.beatapi.io/v1/systemone

# Analysis Configuration
# Suspicion score threshold for flagging as likely fake (0-100)
FAKE_REVIEW_THRESHOLD=60

# Confidence threshold (0-1)
CONFIDENCE_THRESHOLD=0.5

# Recency: prioritize reviews from last N days
RECENCY_DAYS=30

# Optional: Google Maps Data Source
# If integrating with Google Maps API
# GOOGLE_MAPS_API_KEY=your_google_api_key_here
# GOOGLE_MAPS_PLACE_ID=your_place_id_here
